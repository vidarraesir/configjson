# Your Ethereum/Polygon private key (used to sign trades on Polymarket)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket proxy wallet address (your Polymarket wallet, visible in your profile)
PROXY_WALLET=0xYOUR_PROXY_WALLET_HERE

# Address of the trader you want to copy (their Polymarket proxy wallet)
TARGET_TRADER=0xTARGET_TRADER_PROXY_WALLET

# Polling interval in seconds (how often to check for new trades)
POLL_INTERVAL=30

# Proportion of the target trader's position size to copy (0.1 = 10%, 1.0 = 100%)
COPY_RATIO=0.5

# Maximum amount in USDC to risk per single trade
MAX_TRADE_SIZE=50.0

# Minimum trade size in USDC (skip smaller trades)
MIN_TRADE_SIZE=1.0

# Slippage tolerance (0.02 = 2%)
SLIPPAGE=0.02

# Chain ID (137 = Polygon mainnet)
CHAIN_ID=137

# Signature type (0 = EOA, 1 = Magic/Email, 2 = Proxy)
SIGNATURE_TYPE=0

# Dry run mode (true = log trades without executing)
DRY_RUN=true
